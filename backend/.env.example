# Copia este archivo como backend/.env y completa los valores reales.
# NUNCA commitear backend/.env (ya está en .gitignore).

# Flask
FLASK_ENV=development            # production en Render
FLASK_SECRET_KEY=cambia-esto-por-una-clave-larga-aleatoria
JWT_SECRET=cambia-esto-por-otra-clave-larga-aleatoria

# Supabase (Dashboard -> Settings -> API)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...      # SOLO backend; jamás en el frontend

# CORS: URL exacta del frontend (separar con comas si hay varias)
CORS_ORIGINS=http://localhost:5173

# Rate limiting (Redis en producción con >1 worker)
RATELIMIT_STORAGE_URI=memory://

# Yape (datos de cobro mostrados al donante; opcionales)
# YAPE_NUMERO=987 654 321
# YAPE_TITULAR=NutriMap Solidario
