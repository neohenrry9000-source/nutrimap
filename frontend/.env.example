# Copia este archivo como frontend/.env y completa los valores.
# SOLO la anon key va aquí (es pública por diseño; RLS la limita).
# La service key JAMÁS debe ponerse en el frontend.

# URL del backend Flask (en dev el proxy de Vite ya apunta a :8080)
# VITE_API_URL=https://tu-backend.onrender.com/api

# Feed en tiempo real (opcional). Sin esto, el feed usa polling.
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...
